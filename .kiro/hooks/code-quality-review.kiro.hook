{
  "enabled": true,
  "name": "Code Quality Review",
  "description": "Automatically analyzes modified source code files for potential improvements, code smells, design patterns, and best practices. Provides suggestions for improving readability, maintainability, and performance.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.gd",
      "*.gdshader"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Analyze the modified code in the edited file for potential improvements. Focus on:\n1. Code smells and anti-patterns\n2. Opportunities to apply design patterns\n3. Readability and maintainability improvements\n4. Performance optimizations\n5. Best practices for the language/framework being used\n\nProvide specific, actionable suggestions while maintaining the existing functionality. Keep suggestions concise and prioritize the most impactful improvements."
  },
  "workspaceFolderName": "AnimationApp",
  "shortName": "code-quality-review"
}